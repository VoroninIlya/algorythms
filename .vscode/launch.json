    "version": "0.2.0",
    "configurations": [
      {
        "name": "(gdb) Launch",
        "type": "cppdbg",
        "request": "launch",
        "program": "${command:cmake.launchTargetDirectory}/HelloWorldProject.elf",
        "args": [],
        "miDebuggerServerAddress": "localhost:5555",
        "miDebuggerArgs": "",
        "stopAtEntry": true,
        "cwd": "${fileDirname}",
        "environment": [],
        "externalConsole": false,
        "MIMode": "gdb",
        "miDebuggerPath": "C:\\msys64\\home\\i.voronin\\SysGCC\\bin\\aarch64-linux-gnu-gdb.exe",
        "setupCommands": [
            {
                "description": "Enable pretty-printing for gdb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            },
            {
                "description": "Set Disassembly Flavor to Intel",
                "text": "-gdb-set disassembly-flavor intel",
                "ignoreFailures": true
            }
        ]
      },
      {
        "name": "(gdb) Linux Debug",
        "type": "cppdbg",
        "request": "launch",
        "program": "${command:cmake.launchTargetDirectory}/test_algorythmes",
        "args": [],
        "stopAtEntry": false,
        "cwd": "${fileDirname}",
        "environment": [],
        "externalConsole": false,
        "MIMode": "gdb",
        "setupCommands": [
            {
                "description": "Enable pretty-printing for gdb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            },
            {
                "text": "handle SIGUSR1 nostop noprint pass",
                "description": "Ignore SIGUSR1",
                "ignoreFailures": true
            },
            {
                "text": "handle SIGUSR2 nostop noprint pass",
                "description": "Ignore SIGUSR2",
                "ignoreFailures": true
            }
